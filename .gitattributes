# ============================================================
# NovaForge Linux — Git Attributes Configuration
# ============================================================
# Ensures that scripts and config files maintain LF line endings
# even when compiled or edited on Windows environments.
# ============================================================

# Auto-detect text files and normalize line endings
* text=auto

# Force shell scripts to use LF line endings
*.sh text eol=lf
scripts/* text eol=lf
build/scripts/* text eol=lf

# Force live-build hooks to use LF line endings
*.hook.chroot text eol=lf
build/config/hooks/* text eol=lf
build/config/hooks/live/* text eol=lf

# Force live-build auto scripts to use LF line endings
build/auto/* text eol=lf

# Force package lists and configurations to use LF line endings
*.list.chroot text eol=lf
*.preseed.chroot text eol=lf
*.conf text eol=lf
*.desktop text eol=lf
*.qml text eol=lf
*.desc text eol=lf

# Keep binary assets unmodified
*.png binary
*.jpg binary
*.jpeg binary
*.svgz binary
*.pf2 binary
