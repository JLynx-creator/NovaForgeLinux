[%General]
author=NovaForge Linux Project
comment=NovaForge dark theme for Qt applications
x11drag=menubar_and_primary_toolbar
alt_mnemonic=true
animate_states=true
blurring=true
button.variant=0
combo_as_lineedit=true
dialog_button_layout=2
fill_rubberband=false
group_toolbar_buttons=false
groupbox_top_label=true
inline_spin_indicators=true
intensity_multiplier=1.3
joined_inactive_tabs=false
layout_spacing=3
left_tabs=true
menu_shadow_depth=8
merge_menubar_with_toolbar=true
no_inactiveness=false
no_window_pattern=false
popup_blurring=true
reduce_menu_opacity=15
reduce_window_opacity=0
respect_DE=true
scrollable_menu=true
scroll_arrows=false
scroll_min_extent=36
shadowless_popup=false
slider_handle_length=22
slider_handle_width=18
slider_width=4
spin_button_width=20
splitter_width=7
spread_header=true
spread_menuitems=true
spread_progressbar=true
submenu_delay=250
submenu_overlap=0
tickless_slider_handle_size=18
toolbar_icon_size=22
toolbar_interior_spacing=2
toolbutton_style=1
tooltip_delay=300
tooltip_shadow_depth=6
transient_grove=true
transient_scrollbar=true
tree_branch_line=true
vertical_spin_indicators=false

[GeneralColors]
window.color=#11111b
base.color=#181825
alt.base.color=#1e1e2e
button.color=#1e1e2e
light.color=#313244
mid.light.color=#45475a
dark.color=#11111b
mid.color=#181825
highlight.color=#00e5ff
inactive.highlight.color=#00b4d8
text.color=#cdd6f4
window.text.color=#cdd6f4
button.text.color=#cdd6f4
disabled.text.color=#585b70
tooltip.text.color=#cdd6f4
highlight.text.color=#11111b
link.color=#00e5ff
link.visited.color=#7c3aed

[Hacks]
transparent_dolphin_view=false
transparent_ktitle_label=true
transparent_menutitle=true
blur_translucent=true
disabled_icon_opacity=100
force_size_grip=true
iconless_pushbutton=true
kinetic_scrolling=false
lxqtmainmenu_iconsize=22
middle_click_scroll=false
normal_default_pushbutton=true
no_selection_tint=false
opaque_colors=false
respect_darkness=true
single_top_toolbar=false
tint_on_mouseover=0
transparent_arrow_button=true
transparent_pcmanfm_sidepane=true
transparent_pcmanfm_view=false

[PanelButtonCommand]
frame=true
frame.element=button
frame.top=3
frame.bottom=3
frame.left=3
frame.right=3
interior=true
interior.element=button
indicator.size=10
text.normal.color=#cdd6f4
text.focus.color=#00e5ff
text.press.color=#00b4d8
text.toggle.color=#00e5ff

[ProgressbarContents]
frame=false
interior=true
interior.element=progress-pattern
text.normal.color=#11111b
text.focus.color=#11111b

[Progressbar]
frame=true
frame.element=progress
frame.top=3
frame.bottom=3
frame.left=3
frame.right=3
interior=true
interior.element=progress
text.normal.color=#cdd6f4
text.focus.color=#00e5ff

[WindowTranslucency]
normal=95
reduced=90
