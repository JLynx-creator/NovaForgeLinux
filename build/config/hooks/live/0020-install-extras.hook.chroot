#!/bin/sh
# ============================================================
# NovaForge Linux — Hook 0020: Install Extras
# ============================================================
set -e

echo "=== NovaForge Hook: Installing Extras ==="

# 1. Install VS Code
echo "[NovaForge Hook] Installing Visual Studio Code..."
apt-get install -y code

# 2. Install Ollama (AI/LLM runner)
echo "[NovaForge Hook] Installing Ollama..."
curl -L https://ollama.com/download/ollama-linux-amd64 -o /usr/bin/ollama
chmod +x /usr/bin/ollama

# Create ollama user if it doesn't exist
if ! id -u ollama >/dev/null 2>&1; then
    useradd -r -s /bin/false -U -m -d /usr/share/ollama ollama
fi

# Create ollama systemd service
cat > /etc/systemd/system/ollama.service << 'EOF'
[Unit]
Description=Ollama Service
After=network-online.target

[Service]
ExecStart=/usr/bin/ollama serve
User=ollama
Group=ollama
Restart=always
RestartSec=3
Environment="PATH=/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin"

[Install]
WantedBy=default.target
EOF

# Enable the service (this works inside chroot by setting up symlinks)
systemctl enable ollama || true

echo "=== NovaForge Hook: Extras installation completed ==="
