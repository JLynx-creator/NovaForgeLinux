#!/bin/sh
# ============================================================
# NovaForge Linux — Hook 0010: Setup Repositories
# ============================================================
set -e

echo "=== NovaForge Hook: Setting up Repositories ==="

# Ensure basic utilities are installed for repo setup
apt-get update
apt-get install -y --no-install-recommends \
    gnupg \
    software-properties-common \
    curl \
    ca-certificates

# Create keyrings directory
mkdir -p /etc/apt/keyrings

# 1. Add Graphics Drivers PPA (for NVIDIA drivers)
add-apt-repository -y ppa:graphics-drivers/ppa

# 2. Add VS Code repository
curl -fsSL https://packages.microsoft.com/keys/microsoft.asc | gpg --dearmor -o /etc/apt/keyrings/packages.microsoft.gpg
echo "deb [arch=amd64 signed-by=/etc/apt/keyrings/packages.microsoft.gpg] https://packages.microsoft.com/repos/code stable main" > /etc/apt/sources.list.d/vscode.list

# 3. Add Docker repository
curl -fsSL https://download.docker.com/linux/ubuntu/gpg | gpg --dearmor -o /etc/apt/keyrings/docker.gpg
echo "deb [arch=amd64 signed-by=/etc/apt/keyrings/docker.gpg] https://download.docker.com/linux/ubuntu noble stable" > /etc/apt/sources.list.d/docker.list

# Update package lists with new repositories
apt-get update
echo "=== NovaForge Hook: Repositories configured ==="
