#!/bin/sh
# ============================================================
# NovaForge Linux — Hook 0080: Install Control Center
# ============================================================
set -e

echo "=== NovaForge Hook: Installing Control Center ==="

# Ensure PyQt5, psutil and Polkit are installed
apt-get install -y --no-install-recommends \
    python3-pyqt5 \
    python3-psutil \
    policykit-1 \
    pkexec

# Set executable permission on main.py
chmod +x /usr/share/novaforge/control-center/main.py

# Create system launcher link
ln -sf /usr/share/novaforge/control-center/main.py /usr/bin/novaforge-control-center

# Set executable permission on AI chat, webui, and wallpaper scripts
if [ -f /usr/bin/novaforge-chat ]; then
    chmod +x /usr/bin/novaforge-chat
fi
if [ -f /usr/bin/novaforge-openwebui ]; then
    chmod +x /usr/bin/novaforge-openwebui
fi
if [ -f /usr/bin/novaforge-wallpaper-scheduler ]; then
    chmod +x /usr/bin/novaforge-wallpaper-scheduler
fi

# Fix launcher file permissions
chmod 644 /usr/share/applications/novaforge-control-center.desktop
for desktop in novaforge-chat.desktop novaforge-openwebui.desktop; do
    if [ -f "/usr/share/applications/$desktop" ]; then
        chmod 644 "/usr/share/applications/$desktop"
    fi
done

echo "=== NovaForge Hook: Control Center installation completed ==="
